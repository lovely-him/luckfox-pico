{
  "permissions": {
    "allow": [
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(git *)"
    ],
    "deny": [
      "Read(.claude/settings.local.json)",
      "Bash(git checkout -- .)",
      "Bash(git checkout .)",
      "Bash(git checkout -- *)",
      "Bash(git checkout *)",
      "Bash(git reset --hard *)",
      "Bash(git restore .)",
      "Bash(git restore *)",
      "Bash(git clean -f *)",
      "Bash(git branch -D *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ]
  },
  "env": {
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "600000",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  }
}

